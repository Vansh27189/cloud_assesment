#!/bin/sh
# ==============================================================================
# Git Pre-Push Hook: Blocks git push if any automated test case fails
# ==============================================================================

echo "🔍 [PRE-PUSH HOOK] Running automated test suite before pushing..."

# Locate python or pytest executable across Windows, Mac, Linux environments
if command -v python.exe >/dev/null 2>&1; then
    python.exe -m pytest tests/ -v
elif command -v python >/dev/null 2>&1; then
    python -m pytest tests/ -v
elif command -v py.exe >/dev/null 2>&1; then
    py.exe -m pytest tests/ -v
elif command -v py >/dev/null 2>&1; then
    py -m pytest tests/ -v
elif command -v pytest >/dev/null 2>&1; then
    pytest tests/ -v
elif [ -f "/c/Python313/python.exe" ]; then
    /c/Python313/python.exe -m pytest tests/ -v
elif [ -f "C:/Python313/python.exe" ]; then
    C:/Python313/python.exe -m pytest tests/ -v
else
    echo "⚠️ Python or pytest not found. Skipping local hook check."
    exit 0
fi

STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "❌ [ERROR] Tests failed! Blocking git push to protect repository integrity."
    echo "Please fix the failing tests before pushing."
    exit 1
fi

echo "✅ [SUCCESS] All 8 test cases passed! Proceeding with git push."
exit 0
